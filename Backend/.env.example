# =============================================================================
# CiviTrak Backend — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string (Render provides this automatically as DATABASE_URL).
# If omitted, CiviTrak falls back to a local SQLite file (civitrak.db) —
# suitable for development only, not for production.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/civitrak

# ---------------------------------------------------------------------------
# CORS — Production Frontend
# ---------------------------------------------------------------------------
# Set to your Vercel deployment URL (no trailing slash).
# Example: https://civitrak.vercel.app
FRONTEND_URL=https://your-civitrak-app.vercel.app

# ---------------------------------------------------------------------------
# Server (usually set automatically by Render; override for local testing)
# ---------------------------------------------------------------------------
# PORT=8000

# ---------------------------------------------------------------------------
# Security / Auth
# ---------------------------------------------------------------------------
# Secret key used to sign JWT/session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use the same value across all Render instances so tokens stay valid after redeploy.
CIVITRAK_AUTH_SECRET=generate-a-64-char-hex-secret-and-paste-here

# (Legacy alias — same value as CIVITRAK_AUTH_SECRET if you ever rename it)
# SECRET_KEY=generate-a-64-char-hex-secret-and-paste-here
