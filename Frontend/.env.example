# =============================================================================
# CiviTrak Frontend — Environment Variables
# Copy this file to .env (or .env.local) and fill in your values.
# In Vercel: add these as Environment Variables in the project settings.
# Never commit .env files.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend API URL
# ---------------------------------------------------------------------------
# Local development (default):
VITE_API_URL=http://127.0.0.1:8000

# Production (set this in Vercel → Project Settings → Environment Variables):
# VITE_API_URL=https://your-civitrak-backend.onrender.com

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# Set to "true" to use local mock data instead of live API calls.
# Useful for UI development without a running backend.
VITE_DEMO_MODE=false
